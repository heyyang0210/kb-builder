# YashanDB 存储服务本地配置模板
# 使用方式：复制为 .env 后填写真实连接信息；.env 已被 git 忽略。

YASDB_JDBC_URL='jdbc:yasdb://数据库地址:端口/数据库名'
YASDB_USERNAME='应用账号'
YASDB_PASSWORD='由密钥系统注入或本地临时填写'
YASDB_JDBC_JAR='./lib/yashandb-jdbc.jar'

YASDB_STORAGE_HOST='127.0.0.1'
YASDB_STORAGE_PORT='14210'
YASDB_STORAGE_MAX_BODY_BYTES='16777216'
