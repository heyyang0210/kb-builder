# ============================================================================
# 知识中心管理平台 - 环境变量配置模板
# ============================================================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据实际情况修改配置值
# 3. 重启服务使配置生效
# ============================================================================

# ----------------------------------------------------------------------------
# 基础服务配置
# ----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ----------------------------------------------------------------------------
# 前端服务配置
# ----------------------------------------------------------------------------
PORT=13510
KNOWLEDGE_CENTER_PUBLIC_HOST=<YOUR_HOST_IP>

# ----------------------------------------------------------------------------
# 认证服务配置
# ----------------------------------------------------------------------------
KNOWLEDGE_CENTER_AUTH_PORT=14200
KNOWLEDGE_CENTER_AUTH_HOST=127.0.0.1
KNOWLEDGE_CENTER_SERVICE_URL=http://<YOUR_HOST_IP>:<PORT>/knowledge-center/
KNOWLEDGE_CENTER_COOKIE_SECURE=false

# CAS 统一认证配置
KNOWLEDGE_CENTER_CAS_URL=https://cas.yasdb.com/cas

# 管理员账号（首次启动时自动创建）
KNOWLEDGE_CENTER_ADMIN_USERNAME=admin
KNOWLEDGE_CENTER_ADMIN_PASSWORD=admin

# 会话有效期（毫秒），默认 8 小时
KNOWLEDGE_CENTER_SESSION_TTL_MS=28800000

# ----------------------------------------------------------------------------
# 文档服务配置
# ----------------------------------------------------------------------------
DOCUMENT_API_PORT=14110

# ----------------------------------------------------------------------------
# 资料加工服务配置
# ----------------------------------------------------------------------------
PINGCODE_API_PORT=18010
PINGCODE_WEB_HOST=127.0.0.1

# ----------------------------------------------------------------------------
# GitLab OAuth 配置
# ----------------------------------------------------------------------------
# 在 GitLab 创建 OAuth Application 后获取以下凭证
# 创建路径：GitLab → Preferences → Applications → New application
KNOWLEDGE_CENTER_GITLAB_OAUTH_CLIENT_ID=
KNOWLEDGE_CENTER_GITLAB_OAUTH_CLIENT_SECRET=

# OAuth 回调地址（必须与 GitLab 中配置的完全一致）
KNOWLEDGE_CENTER_GITLAB_OAUTH_REDIRECT_URI=http://<YOUR_HOST_IP>:<PORT>/knowledge-center/api/gitlab/oauth/callback

# OAuth 权限范围（通常不需要修改）
KNOWLEDGE_CENTER_GITLAB_OAUTH_SCOPES=read_api read_repository

# 个人 GitLab 授权加密密钥（生产必须由密钥系统注入，不得与 OAuth Client Secret 相同）
KNOWLEDGE_CENTER_OAUTH_ENCRYPTION_KEY=

# 开发环境允许 HTTP 回调（生产环境必须设为 false 或删除此行）
KNOWLEDGE_CENTER_GITLAB_OAUTH_DEV_HTTP=true

# ----------------------------------------------------------------------------
# GitLab 服务账号配置（可选，仅在不使用 OAuth 时配置）
# ----------------------------------------------------------------------------
# 格式：GITLAB_TOKEN_<凭证引用名>=<Personal Access Token>
# 例如：GITLAB_TOKEN_production_read=glpat-xxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# 存储配置
# ----------------------------------------------------------------------------
# 存储模式：file（文件）或 database（YashanDB）
KNOWLEDGE_STORAGE_MODE=file

# YashanDB 存储服务配置（仅 KNOWLEDGE_STORAGE_MODE=database 时需要）
# YASDB_STORAGE_URL=http://127.0.0.1:14210
# YASDB_STORAGE_TIMEOUT_MS=15000

# ----------------------------------------------------------------------------
# 大纲服务配置
# ----------------------------------------------------------------------------
# 内部令牌（自动生成，无需手动配置）
# KNOWLEDGE_CENTER_OUTLINE_INTERNAL_TOKEN=
