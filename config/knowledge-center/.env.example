# ============================================================================
# 知识中心管理平台 - 环境变量配置模板
# ============================================================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 根据实际情况修改配置值
# 3. 重启服务使配置生效
# ============================================================================

# ----------------------------------------------------------------------------
# 基础服务与外部访问配置
# ----------------------------------------------------------------------------
KNOWLEDGE_CENTER_ENV=development
NODE_ENV=development
LOG_LEVEL=info
# 开发环境可使用 127.0.0.1；staging/production 必须显式填写对外 IP 或域名。
KNOWLEDGE_CENTER_PUBLIC_BASE_URL=http://127.0.0.1:13510
KNOWLEDGE_CENTER_FRONTEND_PORT=13510
KNOWLEDGE_CENTER_INTERNAL_HOST=127.0.0.1
KNOWLEDGE_CENTER_DOCUMENT_API_PORT=14110
KNOWLEDGE_CENTER_PINGCODE_API_PORT=18010
KNOWLEDGE_CENTER_PINGCODE_HOST=127.0.0.1

# 可选的项目隔离运行时；未配置时使用 PATH 中的命令。
# KNOWLEDGE_CENTER_JAVA_BIN=runtime/toolchains/java-17/bin/java
# KNOWLEDGE_CENTER_NODE_BIN=runtime/toolchains/node-20/bin/node
# KNOWLEDGE_CENTER_NPM_BIN=runtime/toolchains/node-20/bin/npm
# KNOWLEDGE_CENTER_PYTHON_BIN=runtime/venvs/knowledge-center/bin/python
# PLAYWRIGHT_BROWSERS_PATH=runtime/browsers/playwright

# 文档生产 AI 任务租约恢复周期（毫秒）；留空仅执行启动时扫描和显式恢复。
# KNOWLEDGE_PRODUCTION_RECOVERY_INTERVAL_MS=30000

# ----------------------------------------------------------------------------
# 平台认证模块配置
# ----------------------------------------------------------------------------
# 认证由 13510 平台内核直接提供。以下两个变量仅供独立契约测试入口使用。
# KNOWLEDGE_CENTER_AUTH_PORT=14200
# KNOWLEDGE_CENTER_AUTH_HOST=127.0.0.1
# KNOWLEDGE_CENTER_SERVICE_URL 和 Cookie Secure 由 PUBLIC_BASE_URL 的完整 URL 及协议派生，不重复配置。

# CAS 统一认证配置
KNOWLEDGE_CENTER_CAS_URL=https://cas.yasdb.com/cas

# 管理员账号（首次启动时自动创建）
KNOWLEDGE_CENTER_ADMIN_USERNAME=admin
KNOWLEDGE_CENTER_ADMIN_PASSWORD=admin

# 会话有效期（毫秒），默认 8 小时
KNOWLEDGE_CENTER_SESSION_TTL_MS=28800000

# ----------------------------------------------------------------------------
# GitLab OAuth 配置
# ----------------------------------------------------------------------------
# 在 GitLab 创建 OAuth Application 后获取以下凭证
# 创建路径：GitLab → Preferences → Applications → New application
KNOWLEDGE_CENTER_GITLAB_OAUTH_CLIENT_ID=
KNOWLEDGE_CENTER_GITLAB_OAUTH_CLIENT_SECRET=

# OAuth 回调地址由 PUBLIC_BASE_URL 派生，避免环境迁移时遗留旧 IP。

# GitLab REST API 创建分支、提交和 MR 需要 api；已有只读授权需由用户重新连接
# Current git-tools.yasdb.com OAuth application scopes.
# Use api only when the GitLab OAuth application explicitly allows it.
KNOWLEDGE_CENTER_GITLAB_OAUTH_SCOPES="read_api read_repository"

# 个人 GitLab 授权加密密钥（生产必须由密钥系统注入，不得与 OAuth Client Secret 相同）
KNOWLEDGE_CENTER_OAUTH_ENCRYPTION_KEY=

# 开发环境允许 HTTP 回调（生产环境必须设为 false 或删除此行）
KNOWLEDGE_CENTER_GITLAB_OAUTH_DEV_HTTP=true

# ----------------------------------------------------------------------------
# GitLab 服务账号配置（可选，仅在不使用 OAuth 时配置）
# ----------------------------------------------------------------------------
# 格式：GITLAB_TOKEN_<凭证引用名>=<Personal Access Token>
# 例如：GITLAB_TOKEN_production_read=glpat-xxxxxxxxxxxxxxxxxxxx

# ----------------------------------------------------------------------------
# 存储配置
# ----------------------------------------------------------------------------
# 存储模式：file（文件）或 database（YashanDB）
KNOWLEDGE_STORAGE_MODE=file

# 平台可变配置的存储模式：file（GitLab 连接使用 runtime JSON）或 database（YashanDB）
# database 模式会将 GitLab 连接和手册映射写入平台配置库；OAuth 凭据、验证结果和审计仍按各自安全存储保存。
# 未设置时兼容 KNOWLEDGE_STORAGE_MODE；生产切换前必须先执行平台配置迁移计划并完成验收。
KNOWLEDGE_PLATFORM_CONFIG_MODE=file

# YashanDB 存储服务配置（仅 KNOWLEDGE_STORAGE_MODE=database 时需要）
# YASDB_STORAGE_URL=http://127.0.0.1:14210
# YASDB_STORAGE_TIMEOUT_MS=15000
# 文档 SQL 质量检查仅使用另一套测试库 JDBC 连接；账号须只读且只可访问测试数据。
# YASDB_QUALITY_JDBC_URL=jdbc:yasdb://测试库地址:端口/数据库名
# YASDB_QUALITY_USERNAME=测试库只读账号
# YASDB_QUALITY_PASSWORD=由密钥系统注入
# YASDB_QUALITY_ENVIRONMENT=隔离测试库名称

# ----------------------------------------------------------------------------
# 大纲服务配置
# ----------------------------------------------------------------------------
# 内部令牌：前端网关和文档服务必须使用同一个值。
# 本地开发可生成一段随机 64 位十六进制字符串后写入 .env；不要提交真实令牌。
KNOWLEDGE_CENTER_OUTLINE_INTERNAL_TOKEN=

# 大纲管理页面下载的正式 XLSX 模板；默认读取仓库根目录的大纲模板.xlsx。
# KNOWLEDGE_CENTER_OUTLINE_TEMPLATE_PATH=../大纲模板.xlsx
# 大纲管理页面下载的数据库管理手册样例；默认读取仓库根目录的基本数据库管理手册大纲示例.xlsx。
# KNOWLEDGE_CENTER_OUTLINE_SAMPLE_PATH=../基本数据库管理手册大纲示例.xlsx
