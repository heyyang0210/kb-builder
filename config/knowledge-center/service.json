{
  "server": {
    "port": 4100,
    "host": "localhost"
  },
  "security": {
    "encryption_key_env": "AGENT_RUNNER_KEY",
    "cors_origins": [
      "http://localhost:*",
      "http://127.0.0.1:*"
    ],
    "rate_limit": {
      "window_ms": 60000,
      "max_requests": 10
    }
  },
  "logging": {
    "level": "info",
    "file": "logs/execution.log",
    "max_size": "10m",
    "max_files": 5
  },
  "paths": {
    "output": "runtime/agent-runner/output",
    "templates": "knowledge/templates",
    "references": "knowledge/references"
  },
  "documentPaths": [
    {
      "id": "output",
      "name": "生成文档",
      "path": "runtime/agent-runner/output",
      "writable": true,
      "description": "知识库生成器产出的文档"
    },
    {
      "id": "ai-cognitive",
      "name": "AI 体系认知",
      "path": "../ai 体系认知",
      "writable": false,
      "description": "AI 体系认知知识文档"
    },
    {
      "id": "knowledge-center",
      "name": "知识中心建设平台",
      "path": ".codex/知识中心建设平台",
      "writable": true,
      "description": "知识中心建设平台文档"
    }
  ],
  "model": {
    "provider": "openai",
    "model": "gpt-5.5",
    "base_url": "https://api.openai.com/v1",
    "temperature": 0.7,
    "max_tokens": 60000,
    "timeout": 180000,
    "providers": {
      "openai": {
        "name": "OpenAI",
        "base_url": "https://api.openai.com/v1",
        "models": [
          "gpt-5.5",
          "gpt-4.1"
        ]
      },
      "alibaba": {
        "name": "阿里云百炼",
        "base_url": "https://dashscope.aliyuncs.com/api/v1",
        "models": [
          "qwen-max",
          "qwen-plus",
          "qwen-turbo"
        ]
      },
      "zhipu": {
        "name": "智谱 AI",
        "base_url": "https://open.bigmodel.cn/api/paas/v4",
        "models": [
          "glm-4",
          "glm-3-turbo"
        ]
      },
      "deepseek": {
        "name": "DeepSeek",
        "base_url": "https://api.deepseek.com/v1",
        "models": [
          "deepseek-chat",
          "deepseek-reasoner"
        ]
      }
    },
    "api_key_encrypted": "cebc42a5b40585a4abe253efef93e39a:f899cdc44da9972630f3bd02a96dc2e3:3b2861bf07e1ed7a727e59a2f8f17fc8a7a49e444d64f444e0c239d8f34443a4b981ac5f51c932ebbe2f2b4f156c1ccefb802a"
  },
  "mcp": {
    "server_url": "https://knowledgebase.yashandb.com/api/mcp",
    "timeout": 30000,
    "retry_count": 3,
    "cache": {
      "enabled": true,
      "ttl": 3600
    },
    "headers": [
      {
        "name": "X-Ksacraft-Kb-Id",
        "value": "1",
        "encrypted": false,
        "description": "YashanDB官方文档"
      },
      {
        "name": "X-Ksacraft-Kb-Id",
        "value": "24",
        "encrypted": false,
        "description": "YashanDB运维文档"
      }
    ]
  },
  "agentPresets": {
    "presets": [
      {
        "id": "default",
        "name": "默认4步流程",
        "description": "标准的文档生成流程",
        "steps": [
          {
            "name": "planner",
            "agent": "planner",
            "config": {
              "model": "gpt-5.5",
              "temperature": 0.3
            }
          },
          {
            "name": "retriever",
            "agent": "retriever",
            "config": {
              "model": "gpt-5.5"
            }
          },
          {
            "name": "generator",
            "agent": "generator",
            "config": {
              "model": "gpt-5.5",
              "temperature": 0.7
            }
          },
          {
            "name": "validator",
            "agent": "validator",
            "config": {
              "model": "gpt-5.5",
              "temperature": 0.2
            }
          }
        ]
      },
      {
        "id": "fast",
        "name": "快速生成",
        "description": "跳过验证步骤，快速生成文档",
        "steps": [
          {
            "name": "planner",
            "agent": "planner",
            "config": {}
          },
          {
            "name": "retriever",
            "agent": "retriever",
            "config": {}
          },
          {
            "name": "generator",
            "agent": "generator",
            "config": {}
          }
        ]
      }
    ],
    "default_preset": "default"
  }
}
