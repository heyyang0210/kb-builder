# 由 config/database/yashandb.example.json 提供非敏感默认值。
# 生产环境和本地密钥系统通过环境变量覆盖；不要提交密码。
YASDB_JDBC_URL=jdbc:yasdb://127.0.0.1:1688/YASDB
YASDB_USERNAME=knowledge_app
# YASDB_PASSWORD=<由密钥系统注入>
YASDB_JDBC_JAR=apps/yashandb-storage/lib/yashandb-jdbc.jar
YASDB_STORAGE_URL=http://127.0.0.1:14210
YASDB_STORAGE_HOST=127.0.0.1
YASDB_STORAGE_PORT=14210
YASDB_STORAGE_TIMEOUT_MS=15000
YASDB_STORAGE_THREADS=8
YASDB_STORAGE_MAX_BODY_BYTES=10485760
YASDB_STORAGE_SQL_DIR=apps/yashandb-storage/sql
YASDB_EXP_SERVER_HOST=127.0.0.1:1688
YASDB_EXP_OWNER=KNOWLEDGE_APP
YASDB_IMP_FROMUSER=KNOWLEDGE_APP
YASDB_IMP_TOUSER=KNOWLEDGE_APP
