{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["chunkId", "knowledgePoints"],
        "properties": {
          "chunkId": {"type": "string"},
          "knowledgePoints": {
            "type": "array",
            "items": {"$ref": "#/$defs/knowledgePoint"}
          },
          "documentStructure": {
            "type": "object",
            "properties": {
              "headingPath": {
                "type": "array",
                "items": {"type": "string"}
              },
              "sectionTitle": {"type": "string"}
            }
          }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "skillId": {"type": "string"},
        "skillVersion": {"type": "string"},
        "processedChunks": {"type": "integer"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "knowledgePoint": {
      "type": "object",
      "required": ["title", "statement", "knowledgeType", "evidenceText"],
      "properties": {
        "title": {"type": "string"},
        "statement": {"type": "string"},
        "knowledgeType": {"type": "string"},
        "summary": {"type": "string"},
        "keywords": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1
        },
        "evidenceText": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
