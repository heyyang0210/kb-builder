{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knowledge-center.local/packages/platform-contracts/enterprise-profile/v1/enterprise-profile.schema.json",
  "title": "知识中心建设平台企业能力包",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "brand", "modules", "workspaces", "domain", "connectors", "agents", "skills", "prompts", "templates", "qualityRules", "logicalDirectories", "capabilities", "compatibility", "runtimeProjection"],
  "properties": {
    "apiVersion": { "const": "enterprise-profile/v1" },
    "kind": { "const": "EnterpriseProfile" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "brand": { "$ref": "#/$defs/brand" },
    "modules": { "type": "array", "items": { "$ref": "#/$defs/module" } },
    "workspaces": { "type": "array", "items": { "$ref": "#/$defs/workspace" } },
    "domain": { "$ref": "#/$defs/domain" },
    "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } },
    "agents": { "type": "array", "items": { "$ref": "#/$defs/manifestResource" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/manifestResource" } },
    "prompts": { "type": "array", "items": { "$ref": "#/$defs/fileResource" } },
    "templates": { "type": "array", "items": { "$ref": "#/$defs/fileResource" } },
    "qualityRules": { "type": "array", "items": { "$ref": "#/$defs/fileResource" } },
    "generationPolicies": { "type": "array", "items": { "$ref": "#/$defs/generationPolicy" }, "uniqueItems": true },
    "logicalDirectories": { "type": "array", "items": { "$ref": "#/$defs/logicalDirectory" } },
    "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" } },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "runtimeProjection": { "$ref": "#/$defs/runtimeProjection" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "minLength": 2,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "maxLength": 64
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "idRef": { "$ref": "#/$defs/id" },
    "resourceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!\\\\)(?!~)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)[^?#\\u0000-\\u001F]+$"
    },
    "secretRef": {
      "type": "string",
      "oneOf": [
        { "pattern": "^env:[A-Z][A-Z0-9_]{1,126}$" },
        { "pattern": "^secret:[a-z][a-z0-9]*(?:[./-][a-z0-9]+)*$" }
      ]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enterpriseId", "version", "displayName", "language"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "enterpriseId": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "language": { "const": "zh-CN" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platformName", "enterpriseName", "productName"],
      "properties": {
        "platformName": { "$ref": "#/$defs/displayName" },
        "enterpriseName": { "$ref": "#/$defs/displayName" },
        "productName": { "$ref": "#/$defs/displayName" },
        "icon": { "$ref": "#/$defs/brandIcon" }
      }
    },
    "brandIcon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceRef", "alt"],
      "properties": {
        "resourceRef": { "$ref": "#/$defs/resourceRef" },
        "alt": { "$ref": "#/$defs/displayName" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled", "workspaceRef"],
      "properties": {
        "id": { "enum": ["document-generation", "material-processing"] },
        "enabled": { "type": "boolean" },
        "workspaceRef": { "$ref": "#/$defs/idRef" }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "basePath", "backend"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "basePath": {
          "type": "string",
          "pattern": "^/(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]*/?$",
          "maxLength": 160
        },
        "backend": { "enum": ["node", "python"] }
      }
    },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "manifestRef": { "$ref": "#/$defs/resourceRef" }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "enabled", "capabilityRefs", "secretRefs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["local-upload", "pingcode", "mcp"] },
        "enabled": { "type": "boolean" },
        "capabilityRefs": { "type": "array", "items": { "$ref": "#/$defs/idRef" }, "uniqueItems": true },
        "secretRefs": { "type": "array", "items": { "$ref": "#/$defs/secretRef" }, "uniqueItems": true }
      }
    },
    "manifestResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifestRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "manifestRef": { "$ref": "#/$defs/resourceRef" }
      }
    },
    "fileResource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "resourceRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "resourceRef": { "$ref": "#/$defs/resourceRef" }
      }
    },
    "generationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "displayName", "enabled", "documentTypes", "generationModes", "agentRefs", "skillRefs", "promptRefs", "templateRef", "qualityRuleRefs", "sourcePolicy", "outputPolicy", "reviewPolicy"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "enabled": { "type": "boolean" },
        "documentTypes": { "type": "array", "items": { "$ref": "#/$defs/idRef" }, "minItems": 1, "uniqueItems": true },
        "documentTypeNames": { "type": "array", "items": { "$ref": "#/$defs/displayName" }, "minItems": 1, "uniqueItems": true },
        "generationModes": { "type": "array", "items": { "enum": ["full", "incremental", "outline-extraction"] }, "minItems": 1, "uniqueItems": true },
        "agentRefs": { "type": "array", "items": { "$ref": "#/$defs/idRef" }, "minItems": 1, "uniqueItems": true },
        "skillRefs": { "type": "array", "items": { "$ref": "#/$defs/idRef" }, "minItems": 1, "uniqueItems": true },
        "promptRefs": { "type": "array", "items": { "$ref": "#/$defs/idRef" }, "minItems": 1, "uniqueItems": true },
        "templateRef": { "$ref": "#/$defs/idRef" },
        "qualityRuleRefs": { "type": "array", "items": { "$ref": "#/$defs/idRef" }, "minItems": 1, "uniqueItems": true },
        "sourcePolicy": { "$ref": "#/$defs/sourcePolicy" },
        "outputPolicy": { "$ref": "#/$defs/outputPolicy" },
        "reviewPolicy": { "$ref": "#/$defs/reviewPolicy" }
      }
    },
    "sourcePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "allowedConnectorRefs", "requiredConfirmation", "maxSources", "allowKnowledgeBaseFallback"],
      "properties": {
        "mode": { "enum": ["manual", "preset-review", "none"] },
        "allowedConnectorRefs": { "type": "array", "items": { "$ref": "#/$defs/idRef" }, "uniqueItems": true },
        "requiredConfirmation": { "type": "boolean" },
        "maxSources": { "type": "integer", "minimum": 0, "maximum": 100 },
        "allowKnowledgeBaseFallback": { "type": "boolean" }
      }
    },
    "outputPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["logicalDirectoryRef", "pathTemplate", "overwrite"],
      "properties": {
        "logicalDirectoryRef": { "$ref": "#/$defs/idRef" },
        "pathTemplate": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[A-Za-z0-9._{}\\-/]+$" },
        "overwrite": { "enum": ["never", "versioned"] }
      }
    },
    "reviewPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["requiredValidator", "requiredHumanReview"],
      "properties": {
        "requiredValidator": { "type": "boolean" },
        "requiredHumanReview": { "type": "boolean" }
      }
    },
    "logicalDirectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName", "pathRef", "writable"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "$ref": "#/$defs/displayName" },
        "pathRef": { "type": "string", "pattern": "^deployment:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "writable": { "type": "boolean" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "enabled"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["defaultProfile", "legacyEntrypoints", "legacyApiPreserved", "entityTypeAliases"],
      "properties": {
        "defaultProfile": { "type": "boolean" },
        "legacyEntrypoints": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/(?!/)[^?#]*$", "maxLength": 160 },
          "uniqueItems": true
        },
        "legacyApiPreserved": { "type": "boolean" },
        "entityTypeAliases": {
          "type": "object",
          "propertyNames": { "type": "string", "minLength": 1, "maxLength": 80 },
          "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 80 }
        }
      }
    },
    "runtimeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exposedBrandFields", "exposedCapabilityFields"],
      "properties": {
        "exposedBrandFields": {
          "type": "array",
          "items": { "enum": ["platformName", "enterpriseName", "productName", "icon"] },
          "uniqueItems": true
        },
        "exposedCapabilityFields": {
          "type": "array",
          "items": { "enum": ["id", "enabled"] },
          "uniqueItems": true
        }
      }
    }
  }
}
