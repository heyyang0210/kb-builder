{
  "private": true,
  "workspaces": [
    "apps/knowledge-center-api",
    "apps/knowledge-center-web",
    "packages/*"
  ],
  "scripts": {
    "build": "bash tools/repository/build-knowledge-center.sh",
    "check:node": "node tools/repository/check-node-syntax.js",
    "check:ui": "node --test tests/unit/agent-runner/knowledge-center-ui-system.node.test.cjs && node tools/repository/check-knowledge-center-ui.cjs",
    "test:knowledge-center": "jest --config tests/unit/agent-runner/jest.config.js",
    "test:logging": "python3 -m unittest tests/unit/logging/test_log_maintenance.py && jest --config tests/unit/agent-runner/jest.config.js --runInBand tests/unit/agent-runner/log-context.test.js tests/unit/agent-runner/logger-redaction.test.js",
    "test:ui:menus": "node --test tests/e2e/agent-runner/dismissible-menu.node.cjs",
    "verify:change": "bash tools/repository/verify-change.sh",
    "verify:database-api": "bash tools/repository/verify-database-health-api.sh",
    "verify:full": "npm run verify:change && npm run test:ui:menus && npm run build && python3 tests/run_tests.py smoke",
    "test:performance": "node tests/performance/knowledge-center/run.cjs"
  },
  "dependencies": {
    "mermaid": "^11.16.0",
    "playwright": "1.63.0",
    "vditor": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-instrument": "^6.0.3",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0"
  }
}
