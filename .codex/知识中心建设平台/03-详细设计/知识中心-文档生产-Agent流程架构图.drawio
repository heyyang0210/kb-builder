        </mxCell>
        <mxCell id="source" value="来源代理：PingCode / MCP&lt;br&gt;知识库 / 测试用例库 / 允许的网址&lt;br&gt;鉴权与凭据由平台管理" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="170" width="280" height="100" />
        </mxCell>
        <mxCell id="confirm" value="作者预览并确认引用来源" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="310" width="260" height="70" />
        </mxCell>
        <mxCell id="freeze" value="冻结原文来源：GitLab repo / branch / path / commit&lt;br&gt;快照摘要 + 工作副本摘要 + 草稿 revision/editVersion&lt;br&gt;范围 / 模型 / 模板 / 参考来源 / Skill 版本" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="310" width="320" height="115" />
        </mxCell>
        <mxCell id="plan" value="Planner 规划 Agent&lt;br&gt;章节目标、要求映射、验证点" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="440" width="290" height="80" />
        </mxCell>
        <mxCell id="evidence" value="Evidence 资料 Agent&lt;br&gt;仅整理已确认快照与证据位置" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="560" width="290" height="80" />
        </mxCell>
        <mxCell id="write" value="Writer 写作 Agent&lt;br&gt;候选片段 + 引用 / 归纳 / 推理声明&lt;br&gt;新增续写 Skill 经平台版本治理" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="680" width="290" height="100" />
        </mxCell>
        <mxCell id="validate" value="服务端确定性校验&lt;br&gt;schema / UTF-16 范围 / 来源与位置&lt;br&gt;拼接范围外原文；失败不产候选" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="820" width="320" height="100" />
        </mxCell>
        <mxCell id="review" value="可选 Content Reviewer&lt;br&gt;结构、模板、表达与来源支持&lt;br&gt;未执行不标记通过" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="820" width="290" height="100" />
        </mxCell>
        <mxCell id="candidate" value="候选就绪（completed）&lt;br&gt;保存候选、差异、来源及运行元信息&lt;br&gt;尚未保存为草稿" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="970" width="320" height="90" />
        </mxCell>
        <mxCell id="preview" value="作者查看、编辑、放弃或采用&lt;br&gt;查看原文基线、参考来源与推理标记" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="970" width="260" height="90" />
        </mxCell>
        <mxCell id="adopt" value="显式采用事务&lt;br&gt;复核原文、版本与候选摘要&lt;br&gt;revision 与 adopted 原子写入" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="1110" width="320" height="100" />
        </mxCell>
        <mxCell id="conflict" value="409：保留候选和作者内容&lt;br&gt;作者解决冲突后重新采用" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1120" width="260" height="80" />
        </mxCell>
        <mxCell id="quality" value="独立 Quality Agent + 多 Skill&lt;br&gt;提取用例 → 执行 → 比对 → 报告&lt;br&gt;仅返回报告，不送审或发布" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="1250" width="290" height="110" />
        </mxCell>
        <mxCell id="db" value="YashanDB 隔离测试库&lt;br&gt;服务端只读 SQL 门禁&lt;br&gt;凭据不进入 Agent 上下文" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1210" y="1250" width="280" height="100" />
        </mxCell>
        <mxCell id="gate" value="质量报告绑定 revision + 摘要&lt;br&gt;环境、用例、结果、预期与 Skill 版本&lt;br&gt;失败 / 未执行 / 过期：修订并重新检查" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="1400" width="320" height="110" />
        </mxCell>
        <mxCell id="publish" value="作者按门禁送审&lt;br&gt;有权限人员审核、发布" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="1550" width="260" height="90" />
        </mxCell>
        <mxCell id="note" value="编辑器提供“当前格式”与“原始 Markdown”两种同步模式；模式切换不保存、不改变规范化 Markdown 正文。&#10;实现边界：GitLab 原文快照绑定、无仓库空白行为、双模式及多阶段 stageRuns/断点续跑均待实施。候选可预检；正式报告绑定已保存修订。" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="425" y="1560" width="1065" height="100" />
