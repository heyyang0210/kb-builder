  <diagram id="reuse-boundaries" name="02-复用与权限边界">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1650" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="复用架构与权限边界｜唯一业务编排器 + 可替换阶段执行器" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;text;strokeColor=none;fillColor=none;fontStyle=1;fontSize=21;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
