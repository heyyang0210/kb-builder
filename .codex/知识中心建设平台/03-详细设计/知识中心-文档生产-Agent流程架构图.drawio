        </mxCell>
        <mxCell id="head-agents" value="受限 Agent 执行" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
