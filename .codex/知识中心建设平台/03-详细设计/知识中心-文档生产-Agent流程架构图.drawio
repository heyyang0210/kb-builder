        </mxCell>
        <mxCell id="head-tools" value="来源与测试服务" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1190" y="90" width="300" height="50" />
        </mxCell>
        <mxCell id="select" value="作者选择操作与编辑范围&lt;br&gt;首载：GitLab 映射文件快照&lt;br&gt;无仓库/映射/文件：空白 Markdown" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="170" width="260" height="110" />
        </mxCell>
        <mxCell id="auth" value="校验身份、文档权限、原文快照与 revision&lt;br&gt;准备参考来源预览" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
