          <mxGeometry as="geometry" x="480" y="140" width="430" height="100" />
        </mxCell>
        <mxCell id="ui" value="写作界面（作者）&lt;br&gt;来源确认 / 运行进展 / 差异预览&lt;br&gt;引用元信息 / 显式采用" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="140" width="500" height="100" />
        </mxCell>
        <mxCell id="orchestrator" value="唯一生产编排器：production-ai-service.js&lt;br&gt;冻结 GitLab 原文快照、工作副本、来源和版本&lt;br&gt;冻结输入、租约、取消、候选与采用事务&lt;br&gt;目标新增：stageRuns / 产物摘要 / 断点恢复" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="340" width="430" height="160" />
        </mxCell>
        <mxCell id="adapters" value="版本化 WritingStageAdapter&lt;br&gt;StageEnvelope → StageResult&lt;br&gt;schema、超时、配额、取消、迟到失效" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="340" width="500" height="120" />
        </mxCell>
        <mxCell id="agents" value="复用现有 Agent 能力&lt;br&gt;planner-agent / retriever-agent&lt;br&gt;generator-agent / validator-agent&lt;br&gt;LLMClient + 企业 Profile + Skill" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="550" width="300" height="145" />
        </mxCell>
        <mxCell id="generic" value="未来通用 Agent 执行器&lt;br&gt;满足后台接口、授权、隔离准入&lt;br&gt;以同契约替换某个阶段&lt;br&gt;先影子运行与固定集盲评" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1380" y="550" width="230" height="145" />
        </mxCell>
        <mxCell id="source" value="两类来源分离&lt;br&gt;原文基线：平台文档映射的 GitLab 文件快照&lt;br&gt;无仓库/映射/文件时初始正文为空&lt;br&gt;参考资料：production-ai-sources.js / MCPClient" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="550" width="360" height="145" />
        </mxCell>
        <mxCell id="store" value="现有 AggregateStore 与草稿事务&lt;br&gt;Job / 来源快照 / 候选 / revision / 质量报告&lt;br&gt;production-ai-provenance.js：引用、归纳、推理、人工编辑&lt;br&gt;目标阶段轨迹沿用同一事实源，避免双重编排" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="480" y="760" width="430" height="160" />
        </mxCell>
        <mxCell id="quality" value="独立质量执行域&lt;br&gt;production-quality-service.js + 多 Skill&lt;br&gt;提取、执行、结果比对、报告&lt;br&gt;yashandb-quality-adapter.js 受限访问测试库" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="800" width="500" height="130" />
        </mxCell>
        <mxCell id="governance" value="既有审核发布服务&lt;br&gt;仅接受授权用户显式操作&lt;br&gt;Agent 无采用、送审、审批和发布工具" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
