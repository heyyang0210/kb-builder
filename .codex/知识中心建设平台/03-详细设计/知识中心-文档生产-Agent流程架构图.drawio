  <diagram id="production-flow" name="01-完整生产流程">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1550" pageHeight="1750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="文档生产全流程｜目标架构：平台编排、专职 Agent、作者采用" style="html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=14;text;strokeColor=none;fillColor=none;fontStyle=1;fontSize=21;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
