{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contextEnvelope"],
  "properties": {
    "contextEnvelope": {
      "type": "object",
      "required": ["chunks", "documentType", "extractionProfile"],
      "properties": {
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": ["chunkId", "content"],
            "properties": {
              "chunkId": {"type": "string"},
              "content": {"type": "string"},
              "headingPath": {"type": "array", "items": {"type": "string"}},
              "resourceId": {"type": "string"},
              "sourcePath": {"type": "string"},
              "document": {
                "type": "object",
                "properties": {
                  "title": {"type": "string"},
                  "semanticTitle": {"type": "string"},
                  "summary": {"type": "string"},
                  "category": {"type": "string"},
                  "domainTerms": {"type": "array", "items": {"type": "object"}},
                  "knownKeywords": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "documentType": {"type": "string"},
        "extractionProfile": {"type": "string"},
        "domain": {"type": "string"},
        "maxCandidatesPerChunk": {"type": "integer", "minimum": 1, "maximum": 8},
        "document": {
          "type": "object",
          "properties": {
            "title": {"type": "string"},
            "semanticTitle": {"type": "string"},
            "summary": {"type": "string"},
            "category": {"type": "string"},
            "domainTerms": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    }
  }
}
