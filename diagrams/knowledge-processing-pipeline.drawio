      <mxCell id="title-f" value="知识加工流水线执行流程图" style="text;html=1;fontSize=24;fontStyle=1;align=left;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="700" height="45" as="geometry"/></mxCell>
      <mxCell id="start" value="用户点击“开始知识加工”&#xa;创建 taskId，写 task.queued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="110" width="250" height="75" as="geometry"/></mxCell>
      <mxCell id="preflight" value="启动前预检&#xa;批次 / 下载 / 资源清单可验证？&#xa;写 preflight 与输入哈希" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="95" width="280" height="110" as="geometry"/></mxCell>
      <mxCell id="stop-pre" value="终止任务&#xa;中文原因：批次不可验证&#xa;task.failed + quality issue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="250" height="75" as="geometry"/></mxCell>
      <mxCell id="snapshot" value="资料预处理输入选择&#xa;读取已提交 scan/preparation 快照&#xa;缺失才走轻量扫描（带进度）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="95" width="300" height="110" as="geometry"/></mxCell>
      <mxCell id="prep" value="1 资料预处理 · material_preparation&#xa;scan → prepare → validate → commit&#xa;单记录损坏隔离；清单不可验证才终止" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="285" width="300" height="105" as="geometry"/></mxCell>
      <mxCell id="meta" value="2 元数据构建 · metadata_construction&#xa;documents / chunk-contexts&#xa;Schema 校验后提交快照" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="455" width="300" height="90" as="geometry"/></mxCell>
      <mxCell id="extract" value="3 知识提取 · knowledge_extraction&#xa;规则关键词或正式知识候选&#xa;仅正式档按需调用 Agent/模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="610" width="300" height="100" as="geometry"/></mxCell>
      <mxCell id="semantic" value="4 按需语义补充 · semantic_enrichment&#xa;不确定项路由、消歧、补充证据&#xa;调用失败可降级并写质量问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="775" width="300" height="100" as="geometry"/></mxCell>
      <mxCell id="validate" value="5 知识校验与合并 · knowledge_validation&#xa;Schema / 证据 / 冲突 / 重复校验&#xa;合格 → final-results/knowledge.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="940" width="300" height="100" as="geometry"/></mxCell>
      <mxCell id="graph" value="6 图谱与数据集生成 · graph_dataset_generation&#xa;graph/nodes.json、edges.json&#xa;dataset/manifest.json、run-report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="1105" width="300" height="100" as="geometry"/></mxCell>
      <mxCell id="done" value="完成&#xa;task.completed，展示成功/失败/质量问题统计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#059669;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="1235" width="300" height="75" as="geometry"/></mxCell>
      <mxCell id="record-fail" value="单记录异常&#xa;JSON / 文件 / 转换 / Schema 分类&#xa;隔离到 quality，不阻断其他记录" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="620" width="300" height="95" as="geometry"/></mxCell>
      <mxCell id="batch-fail" value="批次级不可验证&#xa;清单、快照或必需 Schema 无法确认&#xa;终止当前批次并保留 traceId" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="350" width="300" height="95" as="geometry"/></mxCell>
      <mxCell id="cancel" value="用户取消 / 服务重启&#xa;阶段边界和长操作回调检查取消标记&#xa;task.cancelled 或 task.interrupted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="1070" width="300" height="95" as="geometry"/></mxCell>
      <mxCell id="events" value="每阶段事件：started / progress / completed / failed / cancelled&#xa;事件含 taskId、stageRunId、资源或处理单元标识；不写完整文档、Prompt、密钥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1270" width="520" height="70" as="geometry"/></mxCell>
