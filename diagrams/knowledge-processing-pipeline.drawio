        <mxCell id="s1" value="1 资料预处理 · material_preparation&#xa;扫描 / 转换 / 清洗 / 结构化处理单元&#xa;仅规则，不调用模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" vertex="1" parent="pipeline"><mxGeometry x="25" y="65" width="195" height="115" as="geometry"/></mxCell>
        <mxCell id="s2" value="2 元数据构建 · metadata_construction&#xa;标题路径 / 上下文 / 摘要索引&#xa;仅规则，不调用模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontSize=13;" vertex="1" parent="pipeline"><mxGeometry x="245" y="65" width="195" height="115" as="geometry"/></mxCell>
        <mxCell id="s3" value="3 知识提取 · knowledge_extraction&#xa;关键词或正式知识候选&#xa;Agent/Skill 按需调用模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=13;" vertex="1" parent="pipeline"><mxGeometry x="465" y="65" width="195" height="115" as="geometry"/></mxCell>
        <mxCell id="s4" value="4 按需语义补充 · semantic_enrichment&#xa;处理不确定项 / 语义消歧&#xa;Agent/Skill 按需调用模型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontSize=13;" vertex="1" parent="pipeline"><mxGeometry x="685" y="65" width="195" height="115" as="geometry"/></mxCell>
        <mxCell id="s5" value="5 知识校验与合并 · knowledge_validation&#xa;Schema / 证据 / 冲突校验&#xa;不合格记录进入质量问题" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffedd5;strokeColor=#ea580c;fontSize=13;" vertex="1" parent="pipeline"><mxGeometry x="905" y="65" width="195" height="115" as="geometry"/></mxCell>
